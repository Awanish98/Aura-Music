{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix ui install --legacy-peer-deps",
  "buildCommand": "npm --prefix ui run build",
  "outputDirectory": "ui/build",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://aura-music-1no9.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
