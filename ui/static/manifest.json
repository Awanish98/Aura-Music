{
  "name": "Aura Music — High-Fidelity Music Streaming",
  "short_name": "Aura Music",
  "description": "Stream unlimited music in 320kbps lossless audio, ad-free, with real-time synchronized lyrics, HD music videos, and AI vibes.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#07090e",
  "theme_color": "#ff2a7a",
  "orientation": "portrait-primary",
  "categories": ["music", "entertainment", "audio"],
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Music",
      "short_name": "Search",
      "description": "Search songs, artists and albums",
      "url": "/search",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    },
    {
      "name": "Explore Charts",
      "short_name": "Explore",
      "description": "Discover trending songs and curated charts",
      "url": "/discover",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    },
    {
      "name": "My Library",
      "short_name": "Library",
      "description": "Your playlists and liked songs",
      "url": "/library",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
